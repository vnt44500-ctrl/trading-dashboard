# Optional API keys. Uncomment and fill to enable extra features.
# NEWS_API_KEY=
# ALPHA_VANTAGE_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ACTIVE_BROKER=paper

# --- SMS signal alerts (Twilio and/or free email-to-SMS gateway) ---
# Enabled when NOTIFY_SMS_ENABLED=true AND at least one provider is complete.
# SMS_PROVIDER: auto (Twilio first, email fallback) | twilio | email (manual).
# Your Canadian handset (+16477167264) is already configured as the recipient.
# NOTIFY_SMS_ENABLED=false
# NOTIFY_SMS_TO=+16477167264
# SMS_PROVIDER=auto
# SMS_PROVIDER_COOLDOWN_MIN=15
# --- Provider 1: Twilio (paid) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# --- Provider 2: free email-to-SMS gateway (any SMTP account) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMS_GATEWAY_TO=6477167264@pcs.rogers.com
# NOTIFY_SMS_INCLUDE_HOLD=false
# NOTIFY_SMS_INCLUDE_RESEARCH=true
# NOTIFY_SMS_DEDUP_HOURS=24